{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Volo AI",
  "version": "0.2.0",
  "identifier": "com.voloai.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:14420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Volo AI",
        "width": 1440,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; connect-src 'self' asset: http://asset.localhost ipc: http://ipc.localhost https://api.github.com; media-src 'self' asset: http://asset.localhost blob:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": ["resources/seed-voices"],
    "externalBin": ["binaries/tts-sidecar", "binaries/audiocpp-cli"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "shell": {
      "open": "^https://(github\\.com/az-forge/volo-ai(/discussions/categories/ideas|/releases/tag/v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*))?|ko-fi\\.com/n2q1910)$"
    }
  }
}
